// The MCP server for the atlas. A separate Worker from the static site.
// Read-only, no sign-in. The free plan caps requests and CPU; it never bills.
{
  "name": "silh-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  "workers_dev": true,
  "preview_urls": false
}
